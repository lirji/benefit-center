# Vite 开发代理的后端地址；浏览器始终请求同源 /openapi /admin /internal。
VITE_BENEFIT_API_TARGET=http://localhost:8183

# 默认 dev:本地免 Casdoor(后端 permitAll + X-Tenant-Id)。联调/生产置 oidc。
VITE_AUTH_MODE=dev
