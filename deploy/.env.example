# Copy to deploy/.env. The database password must match the value used by
# bootstrap-dev-infra.sh when it creates the benefit application user.
DEV_INFRA_NETWORK=dev-infra
BENEFIT_DB_USER=benefit
BENEFIT_DB_PASSWORD=change-me-benefit-db
BENEFIT_REDIS_PASSWORD=change-me-redis
BENEFIT_UI_PORT=8083

# secure 用户开通时，本机联邦推荐显式传 BENEFIT_BUSINESS_TENANT=dev-tenant；
# 该货主写入 JWT properties.tenant_id，登录组织仍是 benefit-center。

# 统一链路追踪；完全关闭可设置 OTEL_SDK_DISABLED=true。
OTEL_EXPORTER_OTLP_ENDPOINT=http://infra-otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# secure 本地 overlay 默认开启 SKU 审批 ACK；两把值都必须是至少 32 随机字节的 Base64URL。
# 不要把真实 key 提交到仓库。
WORKFLOW_KAFKA_ENABLED=true
WORKFLOW_KAFKA_SOURCE_SIGNING_KEYS=
# 权益控制台只读查询审批实例；流程台默认免登录，本机启用其 OIDC 后再配置机器 token。
WORKFLOW_HTTP_BASE_URL=http://workflow-server:8300
WORKFLOW_HTTP_BEARER_TOKEN=
# 逗号分隔的受控机器主体；只在目录读取和发奖接口接受显式业务租户头。
# 机器请求仍必须逐次携带 X-Tenant-Id，不能省略该头来列举全部货主。
BENEFIT_DELEGATED_TENANT_SUBJECTS=benefit-center/marketing-benefit-service
# 本地构建时烘焙；生产未显式配置时保持空。
VITE_WORKFLOW_CONSOLE_ORIGIN=http://localhost:8302
